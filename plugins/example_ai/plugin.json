{
  "name": "example_ai",
  "api_version": 1,
  "version": "1.0.0",
  "description": "官方示例：调用统一 AI 能力（声明式）",
  "author": "OFbot 2",
  "dependencies": {},
  "permissions": ["example_ai.ask"],
  "config_schema": {
    "type": "object",
    "properties": {
      "system_prompt": {
        "type": "string",
        "default": "你是一个友好的机器人助手。",
        "description": "AI 系统提示词"
      }
    }
  },
  "web": false,
  "models": [],
  "migrations": [],
  "entry": "create_plugin",
  "features": [
    {
      "id": "ask",
      "label": "AI 问答",
      "description": "调用已配置的 AI Provider 回答问题",
      "enable_on_default": true,
      "manage_permission": "example_ai.admin",
      "commands": [
        {
          "name": "ask",
          "aliases": ["问问"],
          "handler": "handlers.ask_command",
          "permission": "example_ai.ask",
          "description": "调用已配置的 AI Provider 回答问题",
          "usage": "/ask <问题>",
          "examples": ["/ask 你好"],
          "cooldown": 3,
          "rate_limit": "10/minute"
        }
      ]
    }
  ]
}
