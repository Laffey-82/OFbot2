{
  "name": "calc",
  "api_version": 1,
  "version": "1.0.0",
  "description": "安全计算器：四则运算与幂/取模",
  "author": "OFbot 2",
  "dependencies": {},
  "permissions": ["calc.use"],
  "config_schema": {"type": "object", "properties": {}},
  "web": false,
  "models": [],
  "migrations": [],
  "entry": "create_plugin",
  "features": [
    {
      "id": "calc",
      "label": "计算器",
      "description": "AST 安全解析，不支持任意代码执行",
      "enable_on_default": true,
      "manage_permission": "calc.admin",
      "commands": [
        {
          "name": "calc",
          "aliases": ["计算"],
          "handler": "handlers.calc_command",
          "permission": "calc.use",
          "description": "安全计算表达式（+ - * / // % **）",
          "usage": "/calc <表达式>",
          "examples": ["/calc 1+2*3", "/calc 2**10"],
          "cooldown": 2,
          "rate_limit": "20/minute"
        }
      ]
    }
  ]
}
